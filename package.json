{
  "name": "controle-de-salas-monorepo",
  "version": "1.0.0",
  "description": "A system to manage and forecast classroom and lab needs based on student projections.",
  "author": "Grupo 5",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "// Full-stack Development Environment": "",
    "dev": "docker compose --profile app up --build -d",
    "stop": "docker compose --profile app down",
    "// Focused Development Environments": "",
    "dev:server": "docker compose up postgres server --build -d",
    "dev:web": "docker compose up web --build -d",
    "// Production-like Environment": "",
    "start:prod": "docker compose --profile app up --build -d",
    "stop:prod": "docker compose --profile app down",
    "// Repository Tooling": "",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "test": "npm test --workspace=server && npm test --workspace=web",
    "test:cov": "npm run test:cov --workspace=server && npm run test:cov --workspace=web",
    "commit": "cz",
    "prepare": "npx husky",
    "// SonarQube Analysis": "",
    "sonar:start": "docker compose --profile sonar up -d",
    "sonar:stop": "docker compose --profile sonar down",
    "sonar:scan": "npm run test:cov && dotenv -e .env -- npx sonarqube-scanner",
    "// Server scaffolding script": "",
    "g:feature": "node scripts/generate-feature.js",
    "g:help": "echo 'Usage: npm run g:feature -- <feature-name>' && echo 'Example: npm run g:feature -- course' && echo 'See scripts/README.md for more details'"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grupo-5-Biopark/grupo05.git"
  },
  "bugs": {
    "url": "https://github.com/Grupo-5-Biopark/grupo05/issues"
  },
  "homepage": "https://github.com/Grupo-5-Biopark/grupo05#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/cz-commitlint": "^20.1.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.11",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "commitizen": "^4.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "sonarqube-scanner": "^4.3.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/server/src/modules/*/domain/entities/*.ts": [
      "node scripts/run-plantuml-generation.js",
      "git add docs/uml/*.puml"
    ]
  },
  "overrides": {
    "@nestjs/cli": {
      "glob": "^11.1.0"
    },
    "tmp": "^0.2.4",
    "node-forge": "1.3.2"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
