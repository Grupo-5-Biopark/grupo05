@startuml
!theme plain
skinparam actorStyle awesome
skinparam packageStyle rectangle

title Diagrama de Casos de Uso - Controle de Salas Biopark

' ========== Atores ==========
actor "Usuário\n(Kelli/Ajudante)" as User
actor "Sistema" as System

' ========== Sistema ==========
rectangle "Sistema de Controle de Salas" {
    
    ' --- Autenticação ---
    package "Autenticação" {
        usecase "Fazer Login" as UC_Login
    }
    
    ' --- UC01, UC02, UC03: Gestão de Cursos ---
    package "Gestão de Cursos" {
        usecase "UC01 - Cadastrar Curso" as UC01
        usecase "UC02 - Editar Curso" as UC02
        usecase "UC03 - Visualizar Cursos\ne Turmas" as UC03
    }
    
    ' --- UC04: Gestão de Turmas ---
    package "Gestão de Turmas" {
        usecase "UC04 - Cadastrar Turmas" as UC04
    }
    
    ' --- UC06: Gestão de Salas ---
    package "Gestão de Salas" {
        usecase "UC06 - Gerenciar Salas" as UC06
    }
    
    ' --- Parâmetros de Cálculo ---
    package "Parâmetros de Cálculo" {
        usecase "Configurar Parâmetros\nde Evasão" as UC_ConfigParams
        usecase "Configurar Parâmetros\nde Classificação" as UC_ConfigClass
    }
    
    ' --- UC05, UC07, UC08: Cálculos Automáticos (Sistema) ---
    package "Cálculos Automáticos" {
        usecase "UC05 - Calcular Evasão" as UC05
        usecase "UC07 - Classificar Salas\n(P, M, G)" as UC07
        usecase "UC08 - Prever Ensalamento" as UC08
    }
    
    ' --- UC09: Dashboard e Relatórios ---
    package "Dashboard e Relatórios" {
        usecase "UC09 - Visualizar Dashboard" as UC09
        usecase "Exportar Relatórios" as UC_Export
    }
}

' ========== Relacionamentos - Usuário ==========
User --> UC_Login
User --> UC01
User --> UC02
User --> UC03
User --> UC04
User --> UC06
User --> UC_ConfigParams
User --> UC_ConfigClass
User --> UC09
User --> UC_Export

' ========== Relacionamentos - Sistema (Automático) ==========
System --> UC05
System --> UC07
System --> UC08

' ========== Pré-condições (Includes) ==========
UC01 ..> UC_Login : <<include>>
UC02 ..> UC_Login : <<include>>
UC04 ..> UC_Login : <<include>>
UC06 ..> UC_Login : <<include>>
UC_ConfigParams ..> UC_Login : <<include>>

' ========== Dependências entre casos de uso ==========
UC02 ..> UC01 : <<extend>>\ncurso deve existir
UC03 ..> UC01 : <<extend>>\ncursos cadastrados
UC04 ..> UC01 : <<extend>>\ncurso deve existir

UC05 ..> UC04 : <<include>>\ndados de turmas
UC05 ..> UC_ConfigParams : <<include>>\nparâmetros de evasão

UC07 ..> UC06 : <<include>>\nsalas cadastradas
UC07 ..> UC_ConfigClass : <<include>>\nparâmetros de classificação

UC08 ..> UC04 : <<include>>\nturmas
UC08 ..> UC06 : <<include>>\nsalas
UC08 ..> UC_ConfigParams : <<include>>\nparâmetros

UC09 ..> UC05 : <<include>>\ndados de evasão
UC09 ..> UC08 : <<include>>\nprevisão de ensalamento
UC_Export ..> UC09 : <<extend>>

' ========== Notas ==========
note right of UC01
  **Dados do curso:**
  - Nome
  - Área de conhecimento
  - Ano de início
  - Status
end note

note right of UC04
  **Dados da turma:**
  - Ano
  - Semestre
  - Turno
  - Nº previsto de alunos
end note

note right of UC05
  Calcula diferença entre
  alunos previstos e atuais,
  gerando taxa de evasão
end note

note right of UC06
  **Dados da sala:**
  - Bloco
  - Pavimento
  - Área (m²)
  - Capacidade
end note

note right of UC07
  Classifica automaticamente:
  - **P** = Pequena
  - **M** = Média
  - **G** = Grande
  
  Baseado em m² por aluno
end note

note right of UC08
  Gera previsão de alocação
  de turmas conforme
  disponibilidade e capacidade
end note

note bottom of User
  Usuário autenticado
  (Kelli ou ajudante)
  com acesso completo
end note

note bottom of System
  Processos automáticos
  executados pelo sistema
  sem interação do usuário
end note

@enduml
