@startuml
class Shift {
    +id: number
    +name: string
    +classes: Class[]
}
class Class {
    +id: number
    +courseId: number
    +course: Course
    +shiftId: number
    +shift: Shift
    +year: number
    +semester: number
    +currentStudents: number
}
class Course {
    +id: number
    +name: string
    +knowledgeArea: string
    +vacancies: number
    +periodQuantities: number
    +openingYear: number
    +classes: Class[]
}
@enduml