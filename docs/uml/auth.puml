@startuml
class User {
    +id: number
    +name: string
    +email: string
    -password: string
    +role: string
    +phone: string
    +createdAt: Date
    +setPassword(hashedPassword: string): void
    +getPassword(): string
}
class RefreshToken {
    +id: number
    +tokenHash: string
    +user: User
    +expiresAt: number
    +createdAt: Date
    +revoked: boolean
}

' Relationships
RefreshToken "*" }o-- "1" User
@enduml
